{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User account and profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "grade": { "type": "string", "maxLength": 20 },
        "school": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName"]
    },
    "SupportTicket": {
      "title": "Support Ticket",
      "description": "Student or school support inquiry ticket",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 256 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "subject", "message", "status"]
    },
    "StudyGroup": {
      "title": "Study Group",
      "description": "Student WhatsApp or live study circle",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "groupName": { "type": "string", "maxLength": 100 },
        "subject": { "type": "string", "maxLength": 100 },
        "gradeLevel": { "type": "string", "maxLength": 20 },
        "creatorId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "groupName", "subject", "creatorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles collection"
    },
    "/supportTickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Support tickets submitted by users"
    },
    "/studyGroups/{groupId}": {
      "schema": { "$ref": "#/entities/StudyGroup" },
      "description": "Collaborative study groups"
    }
  }
}
